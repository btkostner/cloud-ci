# Copy to .dev.vars (gitignored) for `mise run //packages/cloud-ci-worker:dev`.
# wrangler dev loads .dev.vars as Worker secret/var bindings automatically.
#
# Any non-empty value works for local dev; the only requirement is that it's
# present, since BeginRun refuses to mint an ingest token at all when
# INGEST_TOKEN_SECRET is unset (src/ingest_token.rs — there is no hardcoded
# fallback). In production this is `wrangler secret put INGEST_TOKEN_SECRET`,
# pending ADR 0004's Secrets Store wiring.
INGEST_TOKEN_SECRET=local-dev-ingest-token-secret

# Any non-empty PEM works for local dev (src/github_app.rs's claims
# construction/encoding don't touch the key). The real RS256 WebCrypto
# signing path needs a real RSA private key to succeed — generate a
# throwaway one with `openssl genrsa -out /tmp/test-key.pem 2048` for
# manual smoke testing; there is no hardcoded fallback. In production
# this becomes a Secrets Store binding once `cloud-ci setup github-app`
# exists (docs/design/auth.md § "GitHub App setup").
GITHUB_APP_PRIVATE_KEY=

# Required secret, same fail-loudly-if-unset pattern as
# INGEST_TOKEN_SECRET/GITHUB_APP_PRIVATE_KEY above: src/lib.rs's
# /webhooks/github route refuses to verify any delivery (500) when this is
# unset, rather than skipping verification. Any non-empty value works for
# local dev; use it as the HMAC key when generating a synthetic
# X-Hub-Signature-256 header for smoke testing. In production this becomes
# a Secrets Store binding once `cloud-ci setup github-app` exists
# (docs/design/auth.md § "Secret storage").
GITHUB_WEBHOOK_SECRET=local-dev-webhook-secret

# GITHUB_APP_ID and GITHUB_ALLOWED_ORGS are normally [vars] in
# wrangler.toml (not secret — see docs/design/auth.md § "Secret storage"),
# but `wrangler dev` reads .dev.vars as an override for [vars] too, which
# is the easiest way to set a local allowlist for smoke testing without
# editing wrangler.toml's deploy-time placeholders. GITHUB_APP_ID only
# needs to be numeric for src/github_app.rs's claim construction; it does
# not need to match a real GitHub App for local dev.
GITHUB_APP_ID=999999

# Same [vars]-but-overridable-via-.dev.vars pattern as GITHUB_APP_ID/
# GITHUB_ALLOWED_ORGS above. `BeginRun`'s OIDC path
# (src/lib.rs::handle_begin_run, src/oidc.rs) matches a presented GitHub
# Actions JWT's `aud` claim against this value exactly, so a synthetic
# smoke-test JWT must set its `aud` to whatever this is. Any value works
# for local dev; `cloud-ci setup` will populate the real exchange URL
# later, same as the other not-yet-built-setup-flow vars.
CLOUD_CI_INGEST_AUDIENCE=https://ci.example.com/exchange
GITHUB_ALLOWED_ORGS=acme-corp

# Same [vars]-but-overridable-via-.dev.vars pattern as GITHUB_APP_ID
# above (docs/design/auth.md § "Human auth: GitHub OAuth"): not secret
# — src/oauth.rs's authorize-URL builder takes it as a plain argument.
# Any value works for local dev; it does not need to match a real
# GitHub App's client id.
GITHUB_APP_CLIENT_ID=Iv1.localdevclientid

# Required secret, same fail-loudly-if-unset pattern as
# GITHUB_WEBHOOK_SECRET above: src/lib.rs's `GET /oauth/callback` route
# refuses to exchange a `code` (503) when this is unset. Any non-empty
# value works for local dev — the real code-exchange HTTP call to
# github.com cannot be exercised without a real GitHub App's client
# secret anyway (see docs/design/auth.md § "Human auth: GitHub OAuth"
# and the round's report on what is/isn't live-verified). In production
# this becomes a Secrets Store binding once `cloud-ci setup github-app`
# exists.
GITHUB_APP_CLIENT_SECRET=local-dev-oauth-client-secret

# Same [vars]-but-overridable-via-.dev.vars pattern as GITHUB_APP_ID
# above: not secret — the Analytics Engine SQL API's URL path needs the
# account id, src/rollup.rs's `query_analytics_engine`. Any value works
# for local dev; `src/rollup.rs`'s live AE SQL API call cannot be
# exercised without a real Cloudflare account id and `ANALYTICS_SQL_TOKEN`
# below anyway (same not-live-verified posture as GITHUB_APP_CLIENT_SECRET
# above), so this only needs to be non-empty to exercise the "which cron
# fired" dispatch and candidate-selection D1 query locally.
CLOUDFLARE_ACCOUNT_ID=0000000000000000000000000000000

# Required secret, same fail-loudly-if-unset pattern as
# GITHUB_WEBHOOK_SECRET above: src/rollup.rs's `*/15` cron refuses to
# query the Analytics Engine SQL API (and logs, not panics — see
# `rollup::run`'s doc comment) when this is unset. In production this is
# a Cloudflare API token scoped to *Account Analytics Read* only
# (docs/design/analytics.md § "Querying for rollups uses the SQL API"),
# `wrangler secret put ANALYTICS_SQL_TOKEN`. Any non-empty value works for
# local dev; the real HTTP call to Cloudflare's SQL API cannot be
# exercised without a real token and account id.
ANALYTICS_SQL_TOKEN=local-dev-analytics-sql-token
