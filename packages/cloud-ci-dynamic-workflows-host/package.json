{
  "name": "cloud-ci-dynamic-workflows-host",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && wrangler dev -c packages/cloud-ci-dynamic-workflows-host/wrangler.toml -c packages/cloud-ci-worker/wrangler.toml",
