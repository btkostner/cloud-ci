    "test": "vitest run",
    "lint": "biome check .",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "@cloudflare/dynamic-workflows": "0.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261002.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.145.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260930.2": true,
    "fsevents@2.3.3": true
  }
